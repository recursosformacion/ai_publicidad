# Configuración local de ejemplo. No guardar credenciales reales aquí.
AI_PUBLICIDAD_ENV=development
# Por defecto se utiliza SQLite para desarrollo y pruebas.
AI_PUBLICIDAD_DATABASE_URL=sqlite:///./ai_publicidad.sqlite3
# Para conectar con MySQL, crea tu propio osap.toml a partir de osap.toml.example
# y deja AI_PUBLICIDAD_DATABASE_URL vacío en tu .env o en la consola de PowerShell.
AI_PUBLICIDAD_PUBLIC_BASE_URL=http://127.0.0.1:8305
AI_PUBLICIDAD_SERVICE_TOKEN=
