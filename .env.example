# Configuración local de ejemplo. No guardar credenciales reales aquí.
AI_PUBLICIDAD_ENV=development
# Por defecto se utiliza SQLite para desarrollo y pruebas.
AI_PUBLICIDAD_DATABASE_URL=sqlite:///./ai_publicidad.sqlite3
# Para conectar con MySQL, crea tu propio osap.toml a partir de osap.toml.example
# y deja AI_PUBLICIDAD_DATABASE_URL vacío en tu .env o en la consola de PowerShell.
AI_PUBLICIDAD_PUBLIC_BASE_URL=http://127.0.0.1:8305
# Los paquetes HTML se sirven desde un origen distinto al de OSAP.
# En producción, usa un subdominio HTTPS dedicado (no la URL de la app).
AI_PUBLICIDAD_PACKAGE_CONTENT_BASE_URL=http://127.0.0.1:8305
AI_PUBLICIDAD_PACKAGE_FRAME_ANCESTORS=http://osap-app
AI_PUBLICIDAD_PACKAGE_ROOT=data/packages
AI_PUBLICIDAD_IMAGE_ROOT=data/media
AI_PUBLICIDAD_IMAGE_MAX_BYTES=5000000
AI_PUBLICIDAD_IMAGE_MAX_DIMENSION=2000
AI_PUBLICIDAD_IMAGE_WEBP_QUALITY=88
AI_PUBLICIDAD_SERVICE_TOKEN=
AI_PUBLICIDAD_VISITOR_HASH_SECRET=
# Solo si vas a usar el laboratorio con MySQL (cada petición cuenta impresiones).
AI_PUBLICIDAD_ENABLE_LAYOUT_LAB=false
