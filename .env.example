# Ejemplo solamente. No guardar credenciales reales aquí.
AI_PUBLICIDAD_ENV=development
# Si no se define AI_PUBLICIDAD_DATABASE_URL, el servicio intenta leer [db] de
# osap.toml (ruta por defecto ./osap.toml o ../osap-api/osap.toml; se puede indicar OSAP_CONFIG).
# En local, sin osap.toml, se usa SQLite automáticamente.
# Para una ruta concreta también se admite AI_PUBLICIDAD_OSAP_CONFIG.
# AI_PUBLICIDAD_OSAP_CONFIG=D:/Proyectos/AI_OSAP/osap-api/osap.toml
# Alternativa explícita para desarrollo local:
# AI_PUBLICIDAD_DATABASE_URL=sqlite:///./ai_publicidad.sqlite3
AI_PUBLICIDAD_PUBLIC_BASE_URL=http://127.0.0.1:8305
AI_PUBLICIDAD_SERVICE_TOKEN=
